{
  "name": "@find-my-pet/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nx serve -p web",
    "dev-dotnet": "nx run-many -t serve -p web dotnet-api",
    "build": "nx run-many -t build",
    "typecheck": "ngc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/web/tsconfig.spec.json --noEmit",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "update": "pnpm update --interactive --latest",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "gc": "f() { p=$1; shift; nx g @nx/angular:component \"apps/web/src/app/$p/$(basename \"$p\")\" \"$@\"; }; f"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.1",
    "@angular/cdk": "~22.2.1",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/material": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/platform-server": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@angular/ssr": "~22.2.1",
    "@mdi/js": "^7.4.47",
    "express": "^5.2.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.1",
    "@angular-devkit/schematics": "~22.2.1",
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "@angular/language-service": "~22.2.1",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/dotnet": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.2.1",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "nx": "23.2.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
